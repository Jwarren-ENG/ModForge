# Required: Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for spec/codegen/repair.
# Default: claude-sonnet-4-6
MODFORGE_MODEL=claude-sonnet-4-6

# Optional: max repair attempts after a failed build. Default: 3
MODFORGE_MAX_REPAIRS=3

# Optional: where generated mod projects are written. Default: ./generated-projects
MODFORGE_WORKSPACE_DIR=
