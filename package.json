{
  "name": "modforge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ModForge AI — generate Minecraft Fabric mods from natural language ideas.",
  "type": "module",
  "bin": {
    "modforge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "web": "tsx src/web/server.ts",
    "dev:web": "tsx watch src/web/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "textures:debug": "tsx scripts/debugTextures.ts",
    "retint:debug": "tsx scripts/debugRetint.ts",
    "vanilla:extract": "tsx scripts/extractVanillaAssets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "prompts": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
